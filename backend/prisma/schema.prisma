// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum UserRole {
  super_admin  @map("super-admin")
  school_admin @map("school-admin")
  teacher
  student
  parent
  accountant
  librarian
  receptionist
}

enum UserStatus {
  active
  inactive
  suspended
}

enum Gender {
  male
  female
  other
}

enum ParentRelationship {
  Father
  Mother
  Guardian
  Other
}

enum TenantStatus {
  active
  suspended
  pending
}

enum GradeLevel {
  elementary
  middle
  high
}

enum SubjectType {
  theory
  practical
  both
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum ExamTerm {
  First_Term   @map("First Term")
  Mid_Term     @map("Mid Term")
  Final_Term   @map("Final Term")
  Unit_Test    @map("Unit Test")
  Monthly_Test @map("Monthly Test")
}

enum ExamStatus {
  scheduled
  ongoing
  completed
  cancelled
}

enum InvoiceStatus {
  unpaid
  partially_paid
  paid
  void
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  online
  stripe
}

enum PaymentGateway {
  manual
  stripe
}

enum NotificationType {
  announcement
  alert
  fee_reminder
  attendance_alert
}

enum NotificationChannel {
  in_app @map("in-app")
  sms
  email
}

enum TargetRole {
  all
  student
  teacher
  parent
}

enum NotificationStatus {
  sent
  pending
  failed
}

enum SalaryStatus {
  pending
  paid
}

enum TaskStatus {
  pending
  completed
}

enum Priority {
  low
  medium
  high
}

enum AssignmentStatus {
  draft
  published
  closed
}

enum MaterialType {
  note
  video
  link
  file
}

enum SubmissionStatus {
  draft
  submitted
  graded
  returned
}

enum CertificateType {
  Academic_Excellence @map("Academic Excellence")
  Perfect_Attendance  @map("Perfect Attendance")
  Course_Completion   @map("Course Completion")
  Sports_Achievement  @map("Sports Achievement")
  Extra_Curricular    @map("Extra-Curricular")
  Graduation
}

enum CertificateStatus {
  active
  revoked
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  SUSPEND
  ACTIVATE
}

enum AuditModule {
  TENANT
  USER
  AUTH
  SUBSCRIPTION
}

enum PermissionResource {
  profile
  grades
  attendance
  assignments
  schedules
  materials
  users
  classes
  subjects
  exams
  fees
  notifications
}

enum PermissionAction {
  create
  read
  update
  delete
}

enum PermissionOperator {
  equals
  not_equals
  in
  not_in
}

enum ExpenseCategory {
  salaries
  rent
  utilities
  maintenance
  supplies
  marketing
  other
}

enum ExpensePaymentMethod {
  cash
  bank_transfer
  cheque
  card
}

enum InventoryStatus {
  available
  out_of_stock @map("out-of-stock")
  maintenance
}

enum ExamComplaintStatus {
  pending
  reviewed
  resolved
  rejected
}

enum ContactMessageStatus {
  new
  read
  replied
  archived
}

enum ContactMessageRole {
  Parent
  Student
  Admin
  Other
}

enum ClassStatus {
  active
  inactive
}

// ─── MODELS ───────────────────────────────────────────────────────────────────

model Tenant {
  id       String       @id @default(cuid())
  tenantId String       @unique
  name     String
  domain   String?      @unique
  status   TenantStatus @default(active)

  // Config (flattened from nested object)
  academicYear   String?
  gradingSystem  String       @default("GPA")
  currency       String       @default("USD")
  timezone       String       @default("UTC")
  logoUrl        String?
  primaryColor   String       @default("#4f46e5")
  secondaryColor String       @default("#1e293b")
  address        String?
  contactEmail   String?
  contactPhone   String?
  vision         String?
  mission        String?
  gradeLevels    GradeLevel[] @default([elementary, middle, high])

  // Subscription (flattened)
  subscriptionPlan   String    @default("basic")
  subscriptionValid  DateTime?
  subscriptionActive Boolean   @default(true)

  superAdminId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  classes         Class[]
  subjects        Subject[]
  exams           Exam[]
  attendances     Attendance[]
  timetables      Timetable[]
  assignments     Assignment[]
  materials       Material[]
  notifications   Notification[]
  salaries        Salary[]
  tasks           Task[]
  invoices        Invoice[]
  payments        Payment[]
  feeTypes        FeeType[]
  expenses        Expense[]
  gradeSystems    GradeSystem[]
  certificates    Certificate[]
  examComplaints  ExamComplaint[]
  auditLogs       AuditLog[]
  books           Book[]
  inventoryItems  InventoryItem[]
  marks           Mark[]
  submissions     Submission[]
  assignmentPerms AssignmentPermission[]

  @@map("tenants")
}

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  firstName     String
  lastName      String
  email         String
  password      String
  role          UserRole
  status        UserStatus @default(active)
  tokenVersion  Int        @default(0)
  lastLogin     DateTime?

  // Profile (flattened)
  phone              String?
  profileAddress     String?
  avatarUrl          String?
  designation        String?
  admissionNo        String?
  studentId          String?
  rollNo             String?
  profileClass       String?
  profileSection     String?
  gender             Gender?
  dob                DateTime?
  motherName         String?
  birthPlace         String?
  disabilityStatus   String?
  orphanStatus       String?
  refugeeStatus      String?
  nationality        String?
  studentState       String?
  studentRegion      String?
  studentDistrict    String?
  studentVillage     String?
  guardianName       String?
  guardianTelephone  String?
  emergencyContactNo String?
  schoolComments     String?
  absenteeismStatus  String?
  regDate            DateTime?
  editDate           DateTime?
  parentRelationship ParentRelationship?
  qualification      String?
  salary             String?
  stripeCustomerId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant? @relation(fields: [tenantId], references: [tenantId])

  // Parent-Child relationship (self-relation via join table)
  parentLinks StudentParent[] @relation("StudentParents")
  childLinks  StudentParent[] @relation("ParentChildren")

  // Role-specific relations
  classTeaching         Class[]               @relation("ClassTeacher")
  subjectTeachings      SubjectTeacher[]
  classSubjectTeachings ClassSubjectTeacher[]
  timetableTeachings    TimetableTeacher[]

  marksGraded    Mark[] @relation("GradedBy")
  marksAsStudent Mark[] @relation("Student")

  attendancesMarked    Attendance[] @relation("AttendanceMarker")
  attendancesAsStudent Attendance[] @relation("AttendanceStudent")

  certificatesIssued   Certificate[] @relation("CertificateIssuer")
  certificatesReceived Certificate[] @relation("CertificateStudent")

  examComplaintsStudent  ExamComplaint[] @relation("ComplaintStudent")
  examComplaintsResolver ExamComplaint[] @relation("ComplaintResolver")

  salaries           Salary[]
  tasks              Task[]
  assignmentsTeacher Assignment[]
  submissions        Submission[]
  assignmentPerms    AssignmentPermission[]

  notificationsSent Notification[]
  notificationsRead NotificationRead[]

  invoicesStudent Invoice[]
  paymentsMarked  Payment[]

  expensesRecorded  Expense[]
  inventoryRecorded InventoryItem[]

  auditLogsPerformed AuditLog[]

  contactMessagesReplied ContactMessage[] @relation("MessageReplier")

  examApprovals Exam[]
  materials     Material[]

  @@index([tenantId])
  @@index([email])
  @@map("users")
}

// Student ↔ Parent many-to-many
model StudentParent {
  id        String @id @default(cuid())
  studentId String
  parentId  String

  student User @relation("StudentParents", fields: [studentId], references: [id], onDelete: Cascade)
  parent  User @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

model Class {
  id             String      @id @default(cuid())
  name           String
  section        String
  gradeLevel     GradeLevel
  grade          String
  room           String?
  classTeacherId String?
  tenantId       String
  status         ClassStatus @default(active)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant @relation(fields: [tenantId], references: [tenantId])
  classTeacher User?  @relation("ClassTeacher", fields: [classTeacherId], references: [id])

  subjects    ClassSubject[]
  timetables  Timetable[]
  attendances Attendance[]
  marks       Mark[]
  assignments Assignment[]
  materials   Material[]
  invoices    Invoice[]
  examClasses ExamClass[]

  @@unique([name, section, tenantId])
  @@index([tenantId])
  @@map("classes")
}

// Class ↔ Subject many-to-many with teachers
model ClassSubject {
  id        String @id @default(cuid())
  classId   String
  subjectId String

  class    Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject  Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teachers ClassSubjectTeacher[]

  @@unique([classId, subjectId])
  @@map("class_subjects")
}

model ClassSubjectTeacher {
  id             String @id @default(cuid())
  classSubjectId String
  teacherId      String

  classSubject ClassSubject @relation(fields: [classSubjectId], references: [id], onDelete: Cascade)
  teacher      User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classSubjectId, teacherId])
  @@map("class_subject_teachers")
}

model Subject {
  id          String       @id @default(cuid())
  name        String
  code        String
  gradeLevels GradeLevel[]
  type        SubjectType  @default(theory)
  credits     Int          @default(3)
  description String?
  tenantId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant         Tenant            @relation(fields: [tenantId], references: [tenantId])
  teachers       SubjectTeacher[]
  resources      SubjectResource[]
  classSubjects  ClassSubject[]
  timetables     Timetable[]
  attendances    Attendance[]
  marks          Mark[]
  materials      Material[]
  examComplaints ExamComplaint[]
  assignments    Assignment[]

  @@unique([name, code, tenantId])
  @@index([tenantId])
  @@map("subjects")
}

model SubjectTeacher {
  id        String @id @default(cuid())
  subjectId String
  teacherId String

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([subjectId, teacherId])
  @@map("subject_teachers")
}

model SubjectResource {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  url       String
  type      String   @default("link")
  addedAt   DateTime @default(now())

  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@map("subject_resources")
}

model Timetable {
  id        String    @id @default(cuid())
  classId   String
  subjectId String
  day       DayOfWeek
  startTime String
  endTime   String
  room      String?
  tenantId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant             @relation(fields: [tenantId], references: [tenantId])
  class    Class              @relation(fields: [classId], references: [id])
  subject  Subject            @relation(fields: [subjectId], references: [id])
  teachers TimetableTeacher[]

  @@unique([classId, day, startTime, tenantId])
  @@index([tenantId])
  @@map("timetables")
}

model TimetableTeacher {
  id          String @id @default(cuid())
  timetableId String
  teacherId   String

  timetable Timetable @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  teacher   User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([timetableId, teacherId])
  @@map("timetable_teachers")
}

model Attendance {
  id         String           @id @default(cuid())
  studentId  String
  classId    String
  date       DateTime
  subjectId  String?
  status     AttendanceStatus @default(present)
  markedById String
  tenantId   String
  remarks    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [tenantId])
  student  User     @relation("AttendanceStudent", fields: [studentId], references: [id])
  class    Class    @relation(fields: [classId], references: [id])
  subject  Subject? @relation(fields: [subjectId], references: [id])
  markedBy User     @relation("AttendanceMarker", fields: [markedById], references: [id])

  @@index([studentId, classId, subjectId, date, tenantId])
  @@index([tenantId])
  @@map("attendances")
}

model Exam {
  id           String     @id @default(cuid())
  name         String
  term         ExamTerm
  startDate    DateTime
  endDate      DateTime
  tenantId     String
  status       ExamStatus @default(scheduled)
  isApproved   Boolean    @default(false)
  approvedById String?
  approvalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant          @relation(fields: [tenantId], references: [tenantId])
  approvedBy User?           @relation(fields: [approvedById], references: [id])
  classes    ExamClass[]
  marks      Mark[]
  complaints ExamComplaint[]

  @@index([tenantId])
  @@map("exams")
}

// Exam ↔ Class many-to-many
model ExamClass {
  id      String @id @default(cuid())
  examId  String
  classId String

  exam  Exam  @relation(fields: [examId], references: [id], onDelete: Cascade)
  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([examId, classId])
  @@map("exam_classes")
}

model Mark {
  id            String  @id @default(cuid())
  examId        String
  studentId     String
  subjectId     String
  classId       String
  marksObtained Float
  maxMarks      Float   @default(100)
  remarks       String?
  grade         String?
  gpa           Float?
  gradeRemarks  String?
  tenantId      String
  gradedById    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant  @relation(fields: [tenantId], references: [tenantId])
  exam     Exam    @relation(fields: [examId], references: [id])
  student  User    @relation("Student", fields: [studentId], references: [id])
  subject  Subject @relation(fields: [subjectId], references: [id])
  class    Class   @relation(fields: [classId], references: [id])
  gradedBy User?   @relation("GradedBy", fields: [gradedById], references: [id])

  @@unique([studentId, examId, subjectId, tenantId])
  @@index([tenantId])
  @@map("marks")
}

model FeeType {
  id          String  @id @default(cuid())
  name        String
  description String?
  amount      Float
  tenantId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant       Tenant        @relation(fields: [tenantId], references: [tenantId])
  invoiceItems InvoiceItem[]

  @@index([tenantId])
  @@map("fee_types")
}

model Invoice {
  id                    String         @id @default(cuid())
  invoiceNumber         String         @unique
  studentId             String
  classId               String
  totalAmount           Float
  paidAmount            Float          @default(0)
  dueDate               DateTime
  status                InvoiceStatus  @default(unpaid)
  stripePaymentIntentId String?
  paymentGateway        PaymentGateway @default(manual)
  tenantId              String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant        @relation(fields: [tenantId], references: [tenantId])
  student  User          @relation(fields: [studentId], references: [id])
  class    Class         @relation(fields: [classId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([tenantId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  feeTypeId String?
  name      String?
  amount    Float?

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeType FeeType? @relation(fields: [feeTypeId], references: [id])

  @@map("invoice_items")
}

model Payment {
  id                    String         @id @default(cuid())
  invoiceId             String
  amount                Float
  paymentDate           DateTime       @default(now())
  paymentMethod         PaymentMethod
  transactionId         String?
  stripePaymentIntentId String?
  stripeChargeId        String?
  stripeCustomerId      String?
  stripeReceiptUrl      String?
  paymentGateway        PaymentGateway @default(manual)
  tenantId              String
  markedById            String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant   Tenant  @relation(fields: [tenantId], references: [tenantId])
  invoice  Invoice @relation(fields: [invoiceId], references: [id])
  markedBy User    @relation(fields: [markedById], references: [id])

  @@index([tenantId])
  @@map("payments")
}

model Notification {
  id          String                @id @default(cuid())
  title       String
  message     String
  type        NotificationType      @default(announcement)
  channels    NotificationChannel[]
  targetRole  TargetRole            @default(all)
  targetClass String?
  senderId    String
  tenantId    String
  status      NotificationStatus    @default(sent)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant             @relation(fields: [tenantId], references: [tenantId])
  sender User               @relation(fields: [senderId], references: [id])
  readBy NotificationRead[]

  @@index([tenantId])
  @@map("notifications")
}

model NotificationRead {
  id             String @id @default(cuid())
  notificationId String
  userId         String

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@map("notification_reads")
}

model Salary {
  id          String       @id @default(cuid())
  userId      String
  month       String
  year        Int
  basicSalary Float
  netSalary   Float
  status      SalaryStatus @default(pending)
  paymentDate DateTime?
  payslipUrl  String?
  tenantId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant            @relation(fields: [tenantId], references: [tenantId])
  user       User              @relation(fields: [userId], references: [id])
  allowances SalaryAllowance[]
  deductions SalaryDeduction[]

  @@index([tenantId])
  @@map("salaries")
}

model SalaryAllowance {
  id       String @id @default(cuid())
  salaryId String
  name     String
  amount   Float

  salary Salary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@map("salary_allowances")
}

model SalaryDeduction {
  id       String @id @default(cuid())
  salaryId String
  name     String
  amount   Float

  salary Salary @relation(fields: [salaryId], references: [id], onDelete: Cascade)

  @@map("salary_deductions")
}

model Task {
  id          String     @id @default(cuid())
  userId      String
  title       String
  description String?
  dueDate     DateTime?
  status      TaskStatus @default(pending)
  priority    Priority   @default(medium)
  tenantId    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [tenantId])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@map("tasks")
}

model Assignment {
  id          String           @id @default(cuid())
  tenantId    String
  title       String
  description String
  classId     String
  subjectId   String?
  teacherId   String
  dueDate     DateTime
  status      AssignmentStatus @default(published)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant      Tenant                 @relation(fields: [tenantId], references: [tenantId])
  class       Class                  @relation(fields: [classId], references: [id])
  subject     Subject?               @relation(fields: [subjectId], references: [id])
  teacher     User                   @relation(fields: [teacherId], references: [id])
  submissions Submission[]
  permissions AssignmentPermission[]

  @@index([tenantId])
  @@map("assignments")
}

model AssignmentPermission {
  id                 String   @id @default(cuid())
  userId             String
  assignmentId       String
  canSubmit          Boolean  @default(true)
  canUpdate          Boolean  @default(true)
  canDelete          Boolean  @default(true)
  submissionDeadline DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user       User       @relation(fields: [userId], references: [id])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  tenant     Tenant?    @relation(fields: [tenantId], references: [tenantId])
  tenantId   String?

  @@unique([userId, assignmentId])
  @@map("assignment_permissions")
}

model Submission {
  id           String           @id @default(cuid())
  tenantId     String
  assignmentId String
  studentId    String
  content      String?
  filePath     String?
  submittedAt  DateTime         @default(now())
  grade        String?
  feedback     String?
  status       SubmissionStatus @default(submitted)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [tenantId])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@map("submissions")
}

model Material {
  id                String       @id @default(cuid())
  tenantId          String
  title             String
  description       String?
  type              MaterialType @default(note)
  content           String?
  fileUrl           String?
  classId           String
  subjectId         String
  teacherId         String
  visibleToStudents Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [tenantId])
  class   Class   @relation(fields: [classId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
  teacher User    @relation(fields: [teacherId], references: [id])

  @@index([tenantId])
  @@map("materials")
}

model Certificate {
  id                String            @id @default(cuid())
  studentId         String
  tenantId          String
  certificateType   CertificateType
  certificateNumber String            @unique
  issueDate         DateTime          @default(now())
  title             String
  description       String?
  issuerId          String
  grade             String?
  academicYear      String?
  rank              Int?
  score             String?
  examType          String?
  status            CertificateStatus @default(active)
  verificationCode  String            @unique
  isDigital         Boolean           @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant  Tenant @relation(fields: [tenantId], references: [tenantId])
  student User   @relation("CertificateStudent", fields: [studentId], references: [id])
  issuer  User   @relation("CertificateIssuer", fields: [issuerId], references: [id])

  @@index([tenantId])
  @@map("certificates")
}

model Permission {
  id         String                @id @default(cuid())
  resource   PermissionResource
  action     PermissionAction
  conditions PermissionCondition[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resource, action])
  @@map("permissions")
}

model PermissionCondition {
  id           String             @id @default(cuid())
  permissionId String
  field        String
  operator     PermissionOperator
  value        String // Serialized value

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@map("permission_conditions")
}

model GradeSystem {
  id       String  @id @default(cuid())
  tenantId String
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant        @relation(fields: [tenantId], references: [tenantId])
  grades GradeConfig[]

  @@index([tenantId])
  @@map("grade_systems")
}

model GradeConfig {
  id            String  @id @default(cuid())
  gradeSystemId String
  grade         String
  minPercentage Float
  maxPercentage Float
  gpa           Float
  remarks       String?

  gradeSystem GradeSystem @relation(fields: [gradeSystemId], references: [id], onDelete: Cascade)

  @@map("grade_configs")
}

model Expense {
  id            String                @id @default(cuid())
  tenantId      String
  title         String
  category      ExpenseCategory
  amount        Float
  date          DateTime              @default(now())
  paymentMethod ExpensePaymentMethod?
  description   String?
  receiptUrl    String?
  recordedById  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant @relation(fields: [tenantId], references: [tenantId])
  recordedBy User?  @relation(fields: [recordedById], references: [id])

  @@index([tenantId])
  @@map("expenses")
}

model InventoryItem {
  id           String          @id @default(cuid())
  tenantId     String
  itemName     String
  category     String
  quantity     Int
  unit         String          @default("pcs")
  location     String?
  status       InventoryStatus @default(available)
  recordedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant @relation(fields: [tenantId], references: [tenantId])
  recordedBy User?  @relation(fields: [recordedById], references: [id])

  @@index([tenantId])
  @@map("inventory_items")
}

model Book {
  id            String  @id @default(cuid())
  tenantId      String
  title         String
  author        String
  isbn          String?
  category      String?
  quantity      Int     @default(1)
  available     Int     @default(1)
  shelfLocation String?
  coverUrl      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [tenantId])

  @@index([tenantId])
  @@map("books")
}

model ExamComplaint {
  id             String              @id @default(cuid())
  tenantId       String
  studentId      String
  examId         String
  subjectId      String
  currentMark    Float
  reason         String
  status         ExamComplaintStatus @default(pending)
  teacherRemarks String?
  resolvedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant  @relation(fields: [tenantId], references: [tenantId])
  student    User    @relation("ComplaintStudent", fields: [studentId], references: [id])
  exam       Exam    @relation(fields: [examId], references: [id])
  subject    Subject @relation(fields: [subjectId], references: [id])
  resolvedBy User?   @relation("ComplaintResolver", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@map("exam_complaints")
}

model ContactMessage {
  id          String               @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  institution String?
  message     String
  status      ContactMessageStatus @default(new)
  role        ContactMessageRole   @default(Other)
  reply       String?
  repliedById String?
  repliedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  repliedBy User? @relation("MessageReplier", fields: [repliedById], references: [id])

  @@index([status])
  @@index([email])
  @@map("contact_messages")
}

model AuditLog {
  id            String      @id @default(cuid())
  action        AuditAction
  module        AuditModule
  details       String?
  performedById String?
  tenantId      String?
  ipAddress     String?
  userAgent     String?

  createdAt DateTime @default(now())

  // Relations
  tenant      Tenant? @relation(fields: [tenantId], references: [tenantId])
  performedBy User?   @relation(fields: [performedById], references: [id])

  @@index([tenantId])
  @@map("audit_logs")
}
