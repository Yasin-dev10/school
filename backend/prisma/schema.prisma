model Submission {
  id                  String           @id @default(cuid())
  tenantId            String
  assignmentId        String
  studentId           String
  content             String?
  filePath            String?
  submittedAt         DateTime         @default(now())
  grade               String?
  feedback            String?
  status              SubmissionStatus @default(submitted)
  plagiarismScore     Float?
  plagiarismMatchId   String?
  plagiarismCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [tenantId])
  assignment Assignment @relation(fields: [assignmentId], references: [id])
  student    User       @relation(fields: [studentId], references: [id])

  @@index([tenantId])
  @@map("submissions")
}

model Course {
  id          String   @id @default(cuid())
  tenantId    String
  title       String
  description String?
  classId     String
  subjectId   String?
  createdById String
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [tenantId])
  class     Class    @relation(fields: [classId], references: [id])
  subject   Subject? @relation(fields: [subjectId], references: [id])
  createdBy User     @relation("CourseCreator", fields: [createdById], references: [id])
  lessons   Lesson[]
  quizzes   Quiz[]

  @@index([tenantId, classId])
  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  videoUrl    String
  durationMin Int?
  position    Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress LessonProgress[]

  @@index([courseId, position])
  @@map("lessons")
}

model LessonProgress {
  id          String   @id @default(cuid())
  lessonId    String
  studentId   String
  completed   Boolean  @default(false)
  watchedSecs Int      @default(0)
  updatedAt   DateTime @updatedAt
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([lessonId, studentId])
  @@map("lesson_progress")
}

model Quiz {
  id          String         @id @default(cuid())
  courseId    String
  title       String
  description String?
  passPercent Int            @default(50)
  published   Boolean        @default(true)
  durationMin Int?
  availableFrom DateTime?
  deadline    DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  course      Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions   QuizQuestion[]
  attempts    QuizAttempt[]

  @@index([courseId])
  @@map("quizzes")
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  prompt       String
  options      Json
  correctIndex Int
  points       Int    @default(1)
  position     Int    @default(0)
  questionType String @default("multiple_choice")
  modelAnswer  String?
  keywords     String[]
  quiz         Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId, position])
  @@map("quiz_questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  studentId   String
  answers     Json
  score       Int
  totalPoints Int
  percentage  Float
  passed      Boolean
  submittedAt DateTime @default(now())
  completedAt DateTime?
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([quizId, studentId])
  @@map("quiz_attempts")
}

model Material {
