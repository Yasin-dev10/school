# Local development — same Express API the Flutter mobile app uses.
# Mobile default production host: https://school-ta8j.onrender.com/api
# Mobile local: flutter run --dart-define=USE_LOCAL_API=true
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vercel / production notes:
# - Combined Render deploy serves web + API at https://school-ta8j.onrender.com
# - Set the Vercel project Root Directory to `frontend` if splitting frontends.
# - Set BACKEND_INTERNAL_URL to the deployed backend base URL, without `/api`.
# - Production browser requests always use the same-origin `/api` rewrite.
# - Set NEXT_PUBLIC_SOCKET_URL directly to the backend base URL for Socket.IO.
#
# BACKEND_INTERNAL_URL=https://school-ta8j.onrender.com
# NEXT_PUBLIC_SOCKET_URL=https://school-ta8j.onrender.com
