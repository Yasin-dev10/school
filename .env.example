JWT_SECRET=generate-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_TTL=15m
# Keep lax when frontend and API share a site. If cross-site hosting is unavoidable,
# use none (HTTPS only) and retain the built-in CSRF header protection.
COOKIE_SAME_SITE=lax
FRONTEND_URL=http://localhost:3000
# Additional comma-separated browser origins accepted by the API.
CORS_ORIGINS=
SOCKET_CORS_ORIGIN=http://localhost:3000

# Super admin seed (required for npm run db:seed) — never commit real values
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Optional payment/email/SMS settings used by docker-compose.yml.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Firebase Cloud Messaging (service account credentials)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
PUSH_RETRY_INTERVAL_MS=60000
CALENDAR_REMINDER_INTERVAL_MS=60000

# Optional: enables full Somali/English AI responses. The assistant keeps a local fallback when unset.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
